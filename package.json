{
  "name": "agentville",
  "productName": "AgentVille",
  "version": "0.1.0",
  "description": "A pixel-art town where your AI coding agents live. Walk up to one and start chatting.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "AgentVille contributors",
  "homepage": "https://github.com/arvabranch/AgentVille",
  "repository": {
    "type": "git",
    "url": "https://github.com/arvabranch/AgentVille.git"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --composite false && tsc -p tsconfig.web.json --noEmit --composite false",
    "test": "vitest run",
    "icon": "node --experimental-strip-types --no-warnings scripts/generate-icon.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.330",
    "@anthropic-ai/sdk": "^1.12.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "highlight.js": "^11.12.0",
    "phaser": "~3.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zustand": "^5.1.0"
  },
  "keywords": [
    "electron",
    "phaser",
    "pixel-art",
    "claude",
    "claude-agent-sdk",
    "ai-agents",
    "coding-agents"
  ]
}
