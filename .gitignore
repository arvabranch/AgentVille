userData/
.agentville/
secrets.bin

# Logs and OS junk
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/*
!.vscode/extensions.json

# Claude Code local settings
.claude/settings.local.json
